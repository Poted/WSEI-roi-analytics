# Data files — download locally, never commit
data/criteo/*
data/olist/*
!data/criteo/.gitkeep
!data/olist/.gitkeep

# Environment — no .env files of any kind in version control
.env*

# dbt artifacts
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
dbt/profiles.yml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Jupyter checkpoints
.ipynb_checkpoints/
notebooks/*.ipynb

# OS
.DS_Store
Thumbs.db
